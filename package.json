{
  "name": "courier-hit",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "node scripts/dev-clean.mjs && pnpm -r --parallel dev",
    "dev:web": "node scripts/dev-clean.mjs && pnpm --filter @courier/web dev",
    "dev:api": "node scripts/dev-clean.mjs && pnpm --filter @courier/api dev",
    "dev:clean": "node scripts/dev-clean.mjs",
    "build": "pnpm --filter @courier/web build"
  }
}
