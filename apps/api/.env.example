# Entorno de la API. Copiar a .env y ajustar.
NODE_ENV=development
PORT=3001

# Postgres (Amazon RDS en prod). Formato: postgres://user:pass@host:puerto/db
DATABASE_URL=postgres://postgres:postgres@localhost:5432/courier

# Origen del sitio web (para CORS). Astro dev por defecto:
WEB_ORIGIN=http://localhost:4321

# Sesion (cookie httpOnly)
SESSION_COOKIE_NAME=hs_session
SESSION_TTL_HOURS=168

# Codigo de verificacion por email
EMAIL_CODE_TTL_MINUTES=15
EMAIL_CODE_MAX_ATTEMPTS=5

# Invitacion de staff: horas de validez del token para fijar contrasena
INVITE_TTL_HOURS=72

# --- Proveedor de casillero en Miami: Helga (docs/13) ---
# UN SOLO interruptor de tres posiciones. Antes eran dos banderas booleanas y la
# combinacion "apagada pero simulada" se leia como Helga apagada cuando en
# realidad estaba operando. Aqui no hay combinaciones imposibles:
#
#   off        No se llama a nadie. Los casilleros quedan en 'pending', las
#              prealertas no salen y el robot no agenda ninguna de sus tareas.
#   simulated  PROVEEDOR SIMULADO en proceso: responde las cinco operaciones de
#              Helga sin red ni credenciales, asi que el flujo completo (enlace
#              del casillero, prealerta, avance de estados, descubrimiento y los
#              dos reintentos) se prueba sin tocar la cuenta real. Es el modo de
#              desarrollo. El mundo simulado se guarda en
#              apps/api/.helga-mock.json y se maneja desde /api/dev/helga, que
#              solo existe en este modo.
#              Con NODE_ENV=production la API NO ARRANCA en este modo.
#   on         INTEGRACION REAL: se sale a la red. Todas las credenciales de
#              abajo (salvo APP_ID y TIMEOUT) pasan a ser obligatorias y la API
#              no arranca si falta alguna. Solo desde una IP que el proveedor
#              tenga en su lista blanca; si no, todo responde 403.
HELGA_MODE=off
HELGA_BASE_URL=https://lmexpress.helgasys.com
HELGA_CLIENT_ID=11
HELGA_CLIENT_SECRET=
HELGA_USERNAME=servicioalcliente@hsglobal-services.com
HELGA_PASSWORD=
HELGA_APP_ID=
# Origin registrado en la lista blanca; sin el, Helga responde 403.
HELGA_ORIGIN=https://lmexpress.helgasys.com
HELGA_TIMEOUT_MS=15000
# Solo con HELGA_MODE=simulated: cuanto tarda el paquete de mentira en pasar de un
# estado del proveedor al siguiente. Son 8 pasos hasta el final del tramo, o sea
# que con 2m el recorrido completo dura 16 minutos.
# Si es MAS CORTO que ROBOT_PROVIDER_SYNC_EVERY, el paquete salta varios estados
# entre corridas del robot (el caso realista); si es mas largo, se ve avanzar un
# estado por corrida.
HELGA_SIMULATED_STEP=2m

# --- Tasa de cambio de referencia: indicadores economicos del BCCR ---
# Solo INFORMA el tipo de cambio del dia en la pantalla de Configuración (y, a
# quien puede fijar la tasa, tambien en la de costos). Ningun monto se guarda con
# este valor: el que usa el sistema es la tasa que el administrador fija a mano.
# Apagada, no se pierde ninguna funcion: solo deja de verse la referencia.
#
# INTERRUPTOR LIBRE: a diferencia de Helga, encender esta bandera SIN credenciales
# no impide arrancar. La API avisa por consola y se comporta como si estuviera
# apagada. Asi se puede dejar en true desde ya e ir llenando las credenciales.
BCCR_ENABLED=false
BCCR_BASE_URL=https://gee.bccr.fi.cr/Indicadores/Suscripciones/WS/wsindicadoreseconomicos.asmx/ObtenerIndicadoresEconomicos
# 318 = tipo de cambio de VENTA del dolar (el que se le cobra al cliente)
BCCR_INDICATOR=318
# Nombre, correo y token de la suscripcion al web service del BCCR
BCCR_NAME=
BCCR_EMAIL=
BCCR_TOKEN=
BCCR_TIMEOUT_MS=8000

# --- Pasarela de pago: Onvo Pay (docs.onvopay.com) ---
# UN SOLO interruptor de tres posiciones, igual que HELGA_MODE:
#
#   off        No se ofrece pago con tarjeta. El cliente paga por deposito
#              bancario, que es un flujo completo y no depende de terceros.
#   simulated  PASARELA SIMULADA: ofrece el pago con tarjeta sin credenciales ni
#              llamadas a Onvo. El cobro lo resuelve el propio cliente desde el
#              portal con dos botones (aprobar / rechazar), asi que el flujo
#              completo se prueba sin pasarela real.
#              Con NODE_ENV=production la API NO ARRANCA en este modo.
#   on         PASARELA REAL: se cobra de verdad. Las cuatro credenciales de abajo
#              pasan a ser obligatorias y la API no arranca si falta alguna.
#
# QUE ENTORNO SE TOCA CON "on" lo decide el PREFIJO DE LA LLAVE, no este valor ni
# la URL: las llaves de prueba (onvo_test_*) no tocan la red bancaria real y la
# URL base es la misma para ambos entornos.
ONVO_MODE=off
ONVO_BASE_URL=https://api.onvopay.com/v1
# Llave publicable: la usa el SDK del navegador para montar el formulario de
# tarjeta. Viaja al cliente, no es un secreto. Prefijo onvo_test_publishable_key_
ONVO_PUBLIC_KEY=
# Llave secreta: solo servidor. Crea los intentos de cobro.
# Prefijo onvo_test_secret_key_
ONVO_SECRET_KEY=
# Onvo lo manda TAL CUAL en el header X-Webhook-Secret de cada webhook (no es un
# HMAC del cuerpo). Es lo unico que distingue un cobro real de un POST falso:
# sin el, ningun pago con tarjeta se puede confirmar NUNCA (por eso es obligatorio
# con ONVO_MODE=on). Se obtiene en el dashboard (Developers) al registrar la URL
# de callback. Prefijo webhook_secret_
ONVO_WEBHOOK_SECRET=
ONVO_TIMEOUT_MS=15000

# --- Correo saliente (Amazon SES) ---
# Apagado mientras no exista el servidor en AWS: con false, cada correo se
# imprime completo en la consola y los flujos se pueden probar igual.
# Antes de encenderlo: dominio verificado en SES, cuenta FUERA del sandbox de SES
# (si no, solo llegan correos a direcciones verificadas) y permiso ses:SendEmail.
MAIL_ENABLED=false
MAIL_FROM=HS Global Courier <no-reply@hsglobalcr.com>
# Obligatoria con MAIL_ENABLED=true.
AWS_REGION=us-east-1
# Opcionales: en EC2/ECS lo correcto es el rol de instancia y dejarlas vacias.
# Solo se llenan para probar SES desde fuera de AWS.
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# Opcional: configuration set de SES (metricas y manejo de rebotes).
SES_CONFIGURATION_SET=

# --- Robot de tareas programadas (scheduler) ---
# Interruptor general del robot que corre tareas de fondo cada cierto intervalo.
# Apagado en desarrollo: no queremos temporizadores llamando a integraciones
# mientras se trabaja en local.
#
# SON DOS INTERRUPTORES EN SERIE: hoy todas las tareas son del proveedor, asi que
# ademas de esto hace falta HELGA_MODE distinto de off. Con el robot encendido y
# Helga en off no se agenda nada y la API lo avisa por consola al arrancar.
# Con HELGA_MODE=simulated el robot deberia ir encendido: es el que hace avanzar
# los tramites simulados (si no, hay que llamar a mano a
# POST /api/shipments/sync-provider).
ROBOT_ENABLED=false

# Cada cuanto corre cada tarea. Duracion legible; acepta cualquier unidad: ms, s,
# m, h, d, w, y se pueden combinar ("30m", "2h", "1d", "1h30m").
# Las cuatro tareas son independientes entre si: dos instancias de la MISMA tarea
# no se solapan (candado en base), pero tareas distintas si corren a la vez.

# QUE HACE: le pregunta a Helga el estado de cada paquete activo y avanza los
# tramites (es lo que mueve el timeline que ve el cliente).
# QUE IMPLICA: es el retraso maximo entre lo que pasa en Miami y lo que muestra el
# portal. Mas corto = el cliente lo ve antes, pero mas llamadas al proveedor (una
# por paquete activo, con techo de 200 por corrida). Si hay mas de 200 activos, el
# resto espera a la siguiente: ahi el intervalo tambien limita el rendimiento.
ROBOT_PROVIDER_SYNC_EVERY=15m

# QUE HACE: reintenta enlazar con Helga el casillero de los clientes que quedaron
# en pending/failed (el registro no bloquea si el proveedor falla).
# QUE IMPLICA: es cuanto tarda en recuperarse un cliente que se registro mientras
# Helga estaba caida. OJO, mientras no se enlace ESE CLIENTE NO PUEDE ENTRAR AL
# PORTAL (el login exige synced), asi que este intervalo es tiempo de espera de
# una persona real, no una tarea de fondo cualquiera.
ROBOT_LOCKER_LINK_RETRY_EVERY=1h

# QUE HACE: reenvia a Helga las prealertas pending/failed cuyo casillero ya esta
# enlazado.
# QUE IMPLICA: una prealerta que no llego al proveedor es un paquete que en Miami
# nadie esta esperando. Si el paquete llega antes que el reintento, entra como
# desconocido y hay que casarlo a mano.
ROBOT_PREALERT_RETRY_EVERY=30m

# QUE HACE: trae los paquetes creados directamente en Helga, que nosotros no
# conocemos (flujo 2).
# QUE IMPLICA: es el unico con una ventana que se CIERRA. La op. E solo lista
# paquetes en DIGITADO, asi que este intervalo tiene que ser MAS CORTO que lo que
# tarda tipicamente un paquete en pasar de DIGITADO a AGRUPADA: lo que avance
# entre dos corridas no se vuelve a ver nunca y toca cargarlo a mano.
ROBOT_PACKAGE_DISCOVERY_EVERY=15m

# --- Almacen de archivos adjuntos (comprobantes, fotos de entrega) ---
# Driver de desarrollo: los archivos se guardan en disco local para poder operar
# de punta a punta sin depender de la nube. En AWS esto pasa a S3.
UPLOADS_DIR=./uploads
# Techo del tamano de un adjunto (8 MB). Una foto de celular ronda los 3-5 MB.
UPLOAD_MAX_BYTES=8388608
