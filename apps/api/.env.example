# Entorno de la API. Copiar a .env y ajustar.
NODE_ENV=development
PORT=3001

# Postgres (Amazon RDS en prod). Formato: postgres://user:pass@host:puerto/db
DATABASE_URL=postgres://postgres:postgres@localhost:5432/courier

# Origen del sitio web (para CORS). Astro dev por defecto:
WEB_ORIGIN=http://localhost:4321

# Sesion (cookie httpOnly)
SESSION_COOKIE_NAME=hs_session
SESSION_TTL_HOURS=168

# Codigo de verificacion por email
EMAIL_CODE_TTL_MINUTES=15
EMAIL_CODE_MAX_ATTEMPTS=5

# Invitacion de staff: horas de validez del token para fijar contrasena
INVITE_TTL_HOURS=72

# --- Proveedor de casillero en Miami: Helga (docs/13) ---
# Con HELGA_ENABLED=true, las demas (salvo APP_ID y TIMEOUT) son obligatorias.
# Encenderlo solo desde una IP que el proveedor tenga en su lista blanca.
HELGA_ENABLED=false
HELGA_BASE_URL=https://lmexpress.helgasys.com
HELGA_CLIENT_ID=11
HELGA_CLIENT_SECRET=
HELGA_USERNAME=servicioalcliente@hsglobal-services.com
HELGA_PASSWORD=
HELGA_APP_ID=
# Origin registrado en la lista blanca; sin el, Helga responde 403.
HELGA_ORIGIN=https://lmexpress.helgasys.com
HELGA_TIMEOUT_MS=15000
# PROVEEDOR SIMULADO: responde las cinco operaciones de Helga sin red ni
# credenciales. Sirve para probar el flujo completo (enlace del casillero,
# prealerta, avance de estados, descubrimiento y las dos reconciliaciones) con
# HELGA_ENABLED=false. Si la integracion real esta encendida, esta se ignora.
# Con NODE_ENV=production la API NO ARRANCA si esto esta encendido.
# El mundo simulado se guarda en apps/api/.helga-mock.json y se controla desde
# /api/dev/helga (solo existe con esta bandera en true).
HELGA_MOCK=false
# Cuanto tarda el paquete simulado en pasar de un estado del proveedor al
# siguiente. Son 8 pasos hasta el final del tramo: con 2m el recorrido completo
# dura 16 minutos. Si es MAS CORTO que PROVIDER_SYNC_INTERVAL, el paquete salta
# varios estados entre corridas (el caso realista); si es mas largo, se ve un
# estado por corrida.
HELGA_MOCK_STEP=2m

# --- Tasa de cambio sugerida: indicadores economicos del BCCR ---
# Solo SUGIERE la tasa del dia en la pantalla de costos; el operador la digita y
# esa es la que se guarda. Apagada, el campo simplemente arranca vacio: no se
# pierde ninguna funcion.
#
# INTERRUPTOR LIBRE: a diferencia de Helga, encender esta bandera SIN credenciales
# no impide arrancar. La API avisa por consola y se comporta como si estuviera
# apagada. Asi se puede dejar en true desde ya e ir llenando las credenciales.
BCCR_ENABLED=false
BCCR_BASE_URL=https://gee.bccr.fi.cr/Indicadores/Suscripciones/WS/wsindicadoreseconomicos.asmx/ObtenerIndicadoresEconomicos
# 318 = tipo de cambio de VENTA del dolar (el que se le cobra al cliente)
BCCR_INDICATOR=318
# Nombre, correo y token de la suscripcion al web service del BCCR
BCCR_NAME=
BCCR_EMAIL=
BCCR_TOKEN=
BCCR_TIMEOUT_MS=8000

# --- Pasarela de pago: Onvo Pay (docs.onvopay.com) ---
# Apagada mientras no este probada de punta a punta. Con la pasarela apagada el
# pago con tarjeta no se ofrece y el cliente paga por deposito bancario, que es
# un flujo completo y no depende de terceros.
#
# El ENTORNO lo decide el prefijo de la llave, no la URL: las de prueba
# (onvo_test_*) no tocan la red bancaria real. La URL base es la misma para
# ambos entornos.
ONVO_ENABLED=false
# PASARELA SIMULADA: ofrece el pago con tarjeta sin credenciales ni llamadas a
# Onvo. El cobro lo resuelve el propio cliente desde el portal con dos botones
# (aprobar / rechazar), asi que el flujo completo se puede probar con
# ONVO_ENABLED=false. Si hay credenciales reales, estas mandan y la simulacion se
# ignora. Con NODE_ENV=production la API NO ARRANCA si esto esta encendido.
ONVO_SIMULATE=true
ONVO_BASE_URL=https://api.onvopay.com/v1
# Llave publicable: la usa el SDK del navegador para montar el formulario de
# tarjeta. Viaja al cliente, no es un secreto. Prefijo onvo_test_publishable_key_
ONVO_PUBLIC_KEY=
# Llave secreta: solo servidor. Crea los intentos de cobro.
# Prefijo onvo_test_secret_key_
ONVO_SECRET_KEY=
# Onvo lo manda TAL CUAL en el header X-Webhook-Secret de cada webhook (no es un
# HMAC del cuerpo). Es lo unico que distingue un cobro real de un POST falso:
# sin el, ningun pago con tarjeta se puede confirmar. Se obtiene en el dashboard
# (Developers) al registrar la URL de callback. Prefijo webhook_secret_
ONVO_WEBHOOK_SECRET=
ONVO_TIMEOUT_MS=15000

# --- Correo saliente (Amazon SES) ---
# Apagado mientras no exista el servidor en AWS: con false, cada correo se
# imprime completo en la consola y los flujos se pueden probar igual.
# Antes de encenderlo: dominio verificado en SES, cuenta FUERA del sandbox de SES
# (si no, solo llegan correos a direcciones verificadas) y permiso ses:SendEmail.
MAIL_ENABLED=false
MAIL_FROM=HS Global Courier <no-reply@hsglobalcr.com>
# Obligatoria con MAIL_ENABLED=true.
AWS_REGION=us-east-1
# Opcionales: en EC2/ECS lo correcto es el rol de instancia y dejarlas vacias.
# Solo se llenan para probar SES desde fuera de AWS.
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# Opcional: configuration set de SES (metricas y manejo de rebotes).
SES_CONFIGURATION_SET=

# --- Robot de tareas programadas (scheduler) ---
# Enciende el robot que corre tareas de fondo cada cierto intervalo. Apagado en
# desarrollo. Las tareas del proveedor solo se agendan si ademas HELGA_ENABLED=true
# o HELGA_MOCK=true (con el proveedor simulado el robot tambien corre: es lo que
# hace avanzar los tramites en las pruebas).
SCHEDULER_ENABLED=false
# Intervalos de las tareas. Duracion legible; acepta cualquier unidad: ms, s, m,
# h, d, w (o nombres: "30m", "2h", "1d", "1h30m").
# Sincronizar estados de paquetes con el proveedor.
PROVIDER_SYNC_INTERVAL=15m
# Reintentar el enlace de casilleros que quedaron pending/failed en Helga.
HELGA_LINK_RECONCILE_INTERVAL=1h
# Reenviar prealertas pending/failed cuyo casillero ya esta enlazado.
HELGA_PREALERT_RECONCILE_INTERVAL=30m
# Descubrir paquetes creados directamente en Helga (flujo 2). La op. E solo lista
# los que estan en DIGITADO: si el intervalo es mas largo que lo que tardan en
# avanzar, esos paquetes se pierden y hay que cargarlos a mano.
HELGA_DISCOVERY_INTERVAL=15m
