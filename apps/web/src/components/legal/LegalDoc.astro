---
/*
  LegalDoc — plantilla de lectura de los documentos legales (/legal/*).

  Índice lateral pegajoso con anclas + secciones numeradas. El contenido llega
  como datos desde `data/legal.ts`; este componente solo lo maqueta, así que
  todos los documentos legales se ven y se navegan igual.

  100% estático: cero JavaScript en el cliente (el índice usa anclas nativas y
  `scroll-margin-top` para que el título no quede pegado al borde superior).
*/
import Icon from '../ui/Icon.astro';
import type { LegalSection } from '../../data/legal';

interface Props {
  sections: LegalSection[];
}
const { sections } = Astro.props;
---
<section class="lg wrap">
  <div class="lg__grid">
    <nav class="lg__toc" aria-label="Contenido del documento">
      <div class="lg__toc-inner">
        <div class="lg__toc-title">Contenido</div>
        <ol class="lg__toc-list">
          {sections.map((s) => (
            <li><a href={`#${s.id}`} class="lg__toc-link">{s.title}</a></li>
          ))}
        </ol>
      </div>
    </nav>

    <article class="lg__doc">
      {sections.map((s, i) => (
        <section id={s.id} class="lg__sec">
          <h2 class="lg__sec-title">
            <span class="lg__num">{i + 1}</span>{s.title}
          </h2>
          {s.blocks.map((b) =>
            b.type === 'p' ? (
              <p class="lg__p">{b.text}</p>
            ) : (
              <ul class="lg__list">
                {b.items.map((it) => (
                  <li><Icon name="check" size={15} color="var(--brand)" />{it}</li>
                ))}
              </ul>
            ),
          )}
        </section>
      ))}

      <div class="lg__foot">
        <p class="muted lg__foot-text">¿Alguna duda sobre este documento?</p>
        <a href="/contacto" class="btn btn-ghost">
          Escríbenos<Icon name="arrowR" size={16} />
        </a>
      </div>
    </article>
  </div>
</section>

<style>
  .lg { padding-top: 56px; padding-bottom: 80px; }
  .lg__grid { display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: 56px; align-items: start; }

  /* Índice */
  .lg__toc-inner { position: sticky; top: 96px; }
  .lg__toc-title {
    font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase;
    color: var(--faint); margin-bottom: 14px;
  }
  .lg__toc-list {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-direction: column; gap: 2px;
    border-left: 1px solid var(--line);
  }
  .lg__toc-link {
    display: block; padding: 7px 0 7px 14px; margin-left: -1px;
    border-left: 2px solid transparent;
    font-size: 13.5px; line-height: 1.4; color: var(--muted);
  }
  .lg__toc-link:hover { color: var(--brand); border-left-color: var(--brand-soft); }

  /* Documento */
  .lg__doc { max-width: 720px; }
  .lg__sec { scroll-margin-top: 92px; }
  .lg__sec + .lg__sec { margin-top: 40px; }

  .lg__sec-title {
    display: flex; align-items: baseline; gap: 12px;
    font-family: var(--font-display);
    font-size: 21px; font-weight: 600; color: var(--ink); letter-spacing: -.02em;
    line-height: 1.3; margin-bottom: 14px;
  }
  .lg__num {
    flex-shrink: 0; font-family: var(--font-mono); font-size: 13px;
    color: var(--brand); font-weight: 600;
  }

  .lg__p { color: var(--ink-2); font-size: 15.5px; line-height: 1.75; }
  .lg__p + .lg__p { margin-top: 12px; }

  .lg__list {
    list-style: none; margin: 14px 0 0; padding: 0;
    display: flex; flex-direction: column; gap: 10px;
  }
  .lg__list li {
    display: flex; align-items: flex-start; gap: 10px;
    font-size: 15px; line-height: 1.6; color: var(--ink-2);
  }
  .lg__list :global(svg) { flex-shrink: 0; margin-top: 4px; }
  .lg__list + .lg__p { margin-top: 16px; }

  .lg__foot {
    display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
    margin-top: 48px; padding-top: 28px; border-top: 1px solid var(--line);
  }
  .lg__foot-text { font-size: 15px; }

  @media (max-width: 940px) {
    .lg__grid { grid-template-columns: 1fr; gap: 36px; }
    .lg__toc-inner { position: static; }
    .lg__doc { max-width: none; }
  }

  @media (max-width: 560px) {
    .lg { padding-top: 40px; }
    .lg__sec-title { font-size: 19px; gap: 9px; }
    .lg__p { font-size: 15px; }
  }
</style>
